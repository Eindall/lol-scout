# Clé Riot (developer.riotgames.com). Une clé de dev expire toutes les 24 h :
# demande une clé perso pour ne plus avoir à la changer.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Base dédiée dans ton Postgres existant (host = nom du conteneur Postgres)
DATABASE_URL=postgres://scout:motdepasse@postgres:5432/scout

# Début de la période « Saison » (date de début de saison ou de split)
SEASON_START=2026-01-08T00:00:00Z

# Types de parties récupérées : ranked, normal, tourney (séparés par des virgules)
MATCH_TYPES=ranked

# Limites de ta clé, un peu sous le max (clé perso/dev : 20/1 s et 100/2 min)
RIOT_RATE_LIMITS=19:1,95:120

PORT=3000
